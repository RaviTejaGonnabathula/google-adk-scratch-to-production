# Only application/build inputs enter the Docker context.
**
!Dockerfile
!pyproject.toml
!uv.lock
!agent.py
!agents/
!agents/**
!tools/
!tools/**
!composition/
!composition/**

# Defense in depth; both deployment scripts also validate all upload roots.
**/__pycache__/
**/.adk/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.py[cod]
**/.env
**/.env.*
**/*.json
**/*.pem
**/*.key
**/settings.dev.yaml
